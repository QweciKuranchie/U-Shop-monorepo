# ==============================================================================
# UShop Monorepo Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Root / CI Configuration
# ------------------------------------------------------------------------------
# Enables Nx Cloud remote caching for CI pipelines.
# Overrides the nxCloudAccessToken placeholder in nx.json when set.
NX_CLOUD_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# Supabase Configuration (Seller Center Auth, Database & Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Sanity CMS Configuration (Shared across apps via @repo/sanity)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=4tjg72wm
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-07
NEXT_PUBLIC_SANITY_STUDIO_URL=https://sanity.ushopgh.com
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# ------------------------------------------------------------------------------
# Sanity Studio standalone (studio/.env)
# ------------------------------------------------------------------------------
SANITY_STUDIO_PROJECT_ID=4tjg72wm
SANITY_STUDIO_DATASET=production

# ------------------------------------------------------------------------------
# Primary App Authentication (apps/web/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------------------------
# Satellite Authentication (apps/admin/.env.local)
# ------------------------------------------------------------------------------
# CLERK_IS_SATELLITE=true
# NEXT_PUBLIC_CLERK_DOMAIN=admin.ushopgh.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://ushopgh.com/sign-in

# ------------------------------------------------------------------------------
# Satellite Authentication (apps/seller/.env.local)
# ------------------------------------------------------------------------------
# CLERK_IS_SATELLITE=true
# NEXT_PUBLIC_CLERK_DOMAIN=seller.ushopgh.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://ushopgh.com/sign-in

# ------------------------------------------------------------------------------
# Payment Gateways (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...

# ------------------------------------------------------------------------------
# Media & Assets (ImageKit)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/kuranchie/ushop
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
SANITY_STUDIO_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/kuranchie/ushop
SANITY_STUDIO_IMAGEKIT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# Admin access (server-only; never use a NEXT_PUBLIC_ variable for this)
# ------------------------------------------------------------------------------
# Comma-separated list. Only VERIFIED Clerk emails in this list are treated as admins.
ADMIN_EMAILS=
# Shared secret for the Sanity -> /api/revalidate webhook (cache invalidation)
SANITY_REVALIDATE_SECRET=
# Upstash Redis (REST) for rate limiting. Without these, an in-memory per-instance
# limiter is used (fine for local dev; NOT effective across serverless instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Number of trusted reverse-proxy hops in front of the app (rate-limit IP detection)
TRUSTED_PROXY_HOPS=1

# ------------------------------------------------------------------------------
# Base App URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://ushopgh.com

# ------------------------------------------------------------------------------
# Email Service (Resend)
# ------------------------------------------------------------------------------
# Resend API key for sending order transactional emails
RESEND_API_KEY=
# Default sender email address for transactional notifications
SENDER_EMAIL_ADDRESS=orders@ushopgh.com
# From email header string with display name
RESEND_FROM_EMAIL=UShop <orders@ushopgh.com>

# ------------------------------------------------------------------------------
# Firebase Cloud Messaging & Push Notifications
# ------------------------------------------------------------------------------
# Firebase API key for web app client SDK initialization
NEXT_PUBLIC_FIREBASE_API_KEY=
# Firebase Auth Domain for web app client SDK
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ushop-notifications.firebaseapp.com
# Firebase Project ID for web app client SDK and FCM HTTP v1 API
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ushop-notifications
# Firebase Storage Bucket for web app client SDK
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ushop-notifications.appspot.com
# Firebase Messaging Sender ID for web app client SDK
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Firebase App ID for web app client SDK
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Measurement ID for client analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Firebase Web Push VAPID Key for client push token generation
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Firebase Service Account JSON string for server-side FCM v1 API authentication
FIREBASE_SERVICE_ACCOUNT_JSON=


# Optional: signs newsletter unsubscribe links (falls back to CLERK_SECRET_KEY)
NEWSLETTER_UNSUBSCRIBE_SECRET=

# ------------------------------------------------------------------------------
# Optional: defaults shown. Leave commented to use the built-in value.
# ------------------------------------------------------------------------------
# Loyalty / reward points (apps/web/lib/pointsCalculation.ts)
# LOYALTY_POINTS_AMOUNT=100
# LOYALTY_POINTS_ORDER_THRESHOLD=5
# REWARD_POINTS_AMOUNT=5
# REWARD_POINTS_THRESHOLD=3000

# Storefront company details and links (apps/web/config/contact.ts)
# NEXT_PUBLIC_COMPANY_NAME=UShop
# NEXT_PUBLIC_COMPANY_EMAIL=support@ushopgh.com
# NEXT_PUBLIC_COMPANY_PHONE="+233 50 956 5794"
# NEXT_PUBLIC_COMPANY_ADDRESS="Akweteyman, Commerce District"
# NEXT_PUBLIC_COMPANY_CITY="Accra, Ghana"
# NEXT_PUBLIC_SUPPORT_EMAIL=support@ushopgh.com
# NEXT_PUBLIC_SALES_EMAIL=sales@ushopgh.com
# NEXT_PUBLIC_WHATSAPP_NUMBER=233000000000
# NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/ushopgh
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/ushopgh
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/ushopgh
# NEXT_PUBLIC_X_URL=https://x.com/ushopgh
# NEXT_PUBLIC_TWITTER_URL=https://twitter.com/ushopgh
# NEXT_PUBLIC_PRIVACY_POLICY_URL=/privacy
# NEXT_PUBLIC_TERMS_URL=/terms
# Also supported (long default text lives in config/contact.ts):
# NEXT_PUBLIC_COMPANY_DESCRIPTION, NEXT_PUBLIC_COMPANY_BUSINESS_HOURS_WEEKDAY,
# NEXT_PUBLIC_CONTACT_RESPONSE_TIME, NEXT_PUBLIC_QUICK_RESPONSE_TIME, NEXT_PUBLIC_COPYRIGHT_TEXT

# Sanity Studio
# SANITY_STUDIO_API_VERSION=2026-07-07
# SANITY_STUDIO_URL=   # used by apps/web/next.config.ts

# Legacy fallbacks, still honoured by the code. Prefer the names above.
# SANITY_API_TOKEN=    # fallback for SANITY_API_READ_TOKEN / SANITY_API_WRITE_TOKEN
# SANITY_PROJECT_ID=   # fallback for NEXT_PUBLIC_SANITY_PROJECT_ID
# SUPABASE_URL=        # fallback for NEXT_PUBLIC_SUPABASE_URL
# ADMIN_EMAIL=         # single address; prefer ADMIN_EMAILS

